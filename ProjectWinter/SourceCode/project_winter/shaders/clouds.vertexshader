#version 330 core

layout(location = 0) in vec3 centerOffset; // Position relative to cloud center
layout(location = 1) in vec2 uv;
layout(location = 2) in mat4 instanceMatrix;

uniform mat4 VP;
uniform vec3 CameraRight; // World Space Camera Right
uniform vec3 CameraUp;    // World Space Camera Up

out vec2 UV;
out float VerticalPos; // Keeps the vertical gradient

void main()
{
    UV = uv;

    vec4 worldCenter = instanceMatrix * vec4(centerOffset, 1.0);
    vec2 offset      = (uv - 0.5) * 2.0; // Map UV (0..1) to (-1..1) for offset calculation

    // BILLBOARDING:
    // Expand the vertex relative to the camera's Right/Up vectors.
    // We scale the particle size here!
    float particleSize   = 18.0;
    vec3 vertexPos_world = worldCenter.xyz 
                         + CameraRight * offset.x * particleSize 
                         + CameraUp    * offset.y * particleSize;
    
    // Pass normalized height (0 to 1) relative to the puff for shading
    VerticalPos = uv.y; 

    gl_Position = VP * vec4(vertexPos_world, 1.0);
}
