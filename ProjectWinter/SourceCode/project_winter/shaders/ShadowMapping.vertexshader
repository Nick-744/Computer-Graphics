#version 330 core

layout(location = 0) in vec3 vertexPosition_modelspace;
layout(location = 1) in vec3 vertexNormal_modelspace;
layout(location = 2) in vec2 vertexUV;



// Phong 
// light properties
struct Light
{
    vec4 La;
    vec4 Ld;
    vec4 Ls;
    vec3 lightPosition_worldspace;
};
uniform Light light1;

uniform mat4 P;
uniform mat4 V;
uniform mat4 M;

uniform mat4 light1VP;

out vec4 vertex_position_cameraspace;
out vec3 vertex_position_worldspace;
out vec3 vertex_position_worldspace_s; // Static - WITHOUT wind...
out vec4 vertex_normal_cameraspace;
out vec3 vertex_normal_worldspace;
out vec4 light_direction_cameraspace1;
out vec2 vertex_UV;

out vec4 vertex_position_lightspace1;

flat out vec3 cameraPos_world;

// ===< SNOW >=== //
uniform mat4 snowVP;
out vec4 vertex_position_snowspace;
out vec4 vertex_position_snowspace_s; // Static - WITHOUT wind...
// Taubin Smoothing - Realistic snow!
uniform sampler2D textureSamplerSnowMask; 
uniform int terrainType;
uniform float snowAmount;

out vec4 vertex_position_clipspace; // Reflection

// ===< WIND >=== //
uniform float time;
uniform int windPower;



void main()
{
    // ===< WIND EFFECT >=== //
    vec3 modifiedPosition = vertexPosition_modelspace;
    if (windPower > 0)
    {
        float stiffness = vertexUV.y; // Root -> 0 & Top -> 1

        float windSpeed     = 3.5;
        float windIntensity = 0.08;
        if (windPower == 1 || windPower == 6) windIntensity = 0.005; // Wind mode - Trees

        vec3 worldPos = (M * vec4(modifiedPosition, 1.0)).xyz;
        float wave    = sin(time * windSpeed + worldPos.x + worldPos.z);
        wave         += sin(time * windSpeed + worldPos.x) * 0.6;

        if (windPower > 2)
            modifiedPosition.x += abs(wave * windIntensity * stiffness) * windPower;
        else
            modifiedPosition.x += wave * windIntensity * stiffness;
        modifiedPosition.z += wave * windIntensity * stiffness;
    }
    // ===< TAUBIN SMOOTHING / TIME-BASED INFLATION >=== //
    if (terrainType == 1 && snowAmount >= 1.0)
    {
        float gaeaSnowValue = texture(textureSamplerSnowMask, vertexUV).r;
        
        if (gaeaSnowValue > 0.5)
        {
            // Smooth transition over time (e.g., 5 seconds)
            float transitionDuration = 5.0; // Seconds for full inflation
            float transitionProgress = clamp(time / transitionDuration, 0.0, 1.0);
            
            // Apply smoothstep for smoother acceleration/deceleration
            transitionProgress = smoothstep(0.0, 1.0, transitionProgress);
            
            // Calculate inflationMu: smoothly goes from 0.0 to 0.0006
            float maxInflation = 0.0006;
            float inflationMu  = transitionProgress * maxInflation;
            
            // Apply the inflation along the normal
            modifiedPosition += vertexNormal_modelspace * inflationMu;
        }
    }



    // Output position of the vertex
    gl_Position               =  P * V * M * vec4(modifiedPosition, 1);
    vertex_position_clipspace = gl_Position; // Reflection
    
    // FS
    vertex_position_cameraspace  = V * M * vec4(modifiedPosition, 1);
    vertex_position_worldspace   = (M * vec4(modifiedPosition, 1)).xyz;
    vertex_position_worldspace_s = (M * vec4(vertexPosition_modelspace, 1)).xyz;
    vertex_normal_cameraspace    = V * M * vec4(vertexNormal_modelspace, 0);
    vertex_normal_worldspace     = normalize(mat3(M) * vertexNormal_modelspace);
    light_direction_cameraspace1 = V * vec4(light1.lightPosition_worldspace, 0);

    vertex_UV = vertexUV;

    // Task 4.2
    vertex_position_lightspace1 = light1VP * M * vec4(modifiedPosition, 1);

    // Camera Position WorldSpace
    mat3 invRot     = transpose(mat3(V));
    vec3 trans      = vec3(V[3]);
    cameraPos_world = - invRot * trans;

    // ===< SNOW >=== //
    vertex_position_snowspace   = snowVP * M * vec4(modifiedPosition, 1);
    // Snow anchor WITHOUT wind (so snow sticks to grass)!!!
    vertex_position_snowspace_s = snowVP * M * vec4(vertexPosition_modelspace, 1);
}
