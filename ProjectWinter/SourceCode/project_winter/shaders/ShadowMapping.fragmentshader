#version 330 core

// ============< TERRAIN TEXTURE CREATOR >============ //

// Precomputed terrain base color!!!
vec3 terrainBaseColor;
uniform int isTerrain = 0;

// Main terrain texture
uniform sampler2D textureSamplerWorld;

// Gaea terrain masks
uniform sampler2D textureSamplerSlope;
uniform sampler2D textureSamplerSoil;
uniform sampler2D textureSamplerPeaks;
uniform sampler2D textureSamplerLake;
uniform sampler2D textureSamplerRivers;

// High-resolution material textures
uniform sampler2D textureSamplerRock;
uniform sampler2D textureSamplerGrass;
uniform sampler2D textureSamplerDirt;
uniform sampler2D textureSamplerSand;

// Moving water texture + displacement
uniform float time;
uniform sampler2D textureSamplerWater;
uniform sampler2D displacementTextureSampler;

// Rivers direction!!! Όχι μούφα κίνηση με height gradient από το Peaks texture...
uniform sampler2D textureSamplerRiversDirection;

// ============< END TERRAIN TEXTURE CREATOR >============ //

in vec4 vertex_position_cameraspace;
in vec4 vertex_normal_cameraspace;
in vec3 vertex_normal_worldspace;
in vec4 light_direction_cameraspace1;
in vec2 vertex_UV;
in vec4 vertex_position_lightspace1;

uniform sampler2D shadowMapSampler1;
uniform sampler2D diffuseColorSampler;
uniform sampler2D specularColorSampler;

uniform int useTexture        = 0;
uniform int useTransparentTex = 0;

// light properties
struct Light
{
    vec4 La;
    vec4 Ld;
    vec4 Ls;
    vec3 lightPosition_worldspace;
};
uniform Light light1;

// materials
struct Material
{
    vec4 Ka; 
    vec4 Kd;
    vec4 Ks;
    float Ns; 
};
uniform Material mtl;

out vec4 fragmentColor;

uniform int ChampionOfLight;

// ===< SNOW >=== //
uniform sampler2D snowDepthMapSampler;
in vec4 vertex_position_snowspace;
// Gaea mask
uniform sampler2D textureSamplerSnowMask;
// Snow state
uniform float snowAmount;



vec4 phong(Light light, float visibility, vec4 light_direction_cameraspace);
float ShadowCalculation(vec4 vertex_position_lightspace, sampler2D shadowMapSampler, float bias);

vec3 computeTerrainTexture(vec2 UV);
float hash(vec2 p);

void main()
{
    // Compute terrain texture ONCE per fragment!!!
    if (isTerrain == 1) terrainBaseColor = computeTerrainTexture(vertex_UV);

    // ===< light 1 >=== //
    float shadow     = ShadowCalculation(vertex_position_lightspace1, shadowMapSampler1, 0.0003);
    float visibility = 1.0f - shadow;
    fragmentColor   += phong(light1, visibility, light_direction_cameraspace1);

    vec4 baseColor = fragmentColor; // NO SNOW!!!

    // ===< SNOW ACCUMULATION >=== //
    if (snowAmount > 0.0)
    {
        float snowBlocked  = ShadowCalculation(vertex_position_snowspace, snowDepthMapSampler, 0.001);
        float snowExposure = 1.0 - snowBlocked;

        // Prevent snow from accumulating on very steep slopes!
        {
            vec3 worldUp = vec3(0.0, 1.0, 0.0);
            vec3 nWorld  = normalize(vertex_normal_worldspace);

            float cosTheta = clamp(dot(nWorld, worldUp), 0.0, 1.0);
            float theta    = acos(cosTheta); // radians

            float minSlopeRad = radians(70.0);
            float maxSlopeRad = radians(90.0);

            float t = smoothstep(minSlopeRad, maxSlopeRad, theta);

            float slopeSnowMask = 1.0 - t;
            snowExposure       *= slopeSnowMask;
        }

        // If this is terrain, use the masks to prevent snow 
        if (isTerrain == 1)
        {
            float lake    = texture(textureSamplerLake, vertex_UV).r;
            lake          = smoothstep(0.2, 0.8, lake);
            snowExposure *= (1.0 - lake);

            float riverMask = texture(textureSamplerRivers, vertex_UV).r;
            riverMask       = smoothstep(0.05, 0.40, riverMask);
            snowExposure   *= (1.0 - riverMask);

            float gaeaSnowMask = texture(textureSamplerSnowMask, vertex_UV).r;
            snowExposure      *= gaeaSnowMask;
        }

        float snowVisibility = snowExposure * snowAmount; // FINAL SNOW MASK
        snowVisibility       = clamp(snowVisibility, 0.0, 1.0);

        if (snowVisibility > 0.001)
        {
            // Pixel-by-pixel snow accumulation using noise
            vec2 snowUV      = vertex_position_snowspace.xy * 2000.0; // Small snow pixels!
            float pixelNoise = hash(floor(snowUV));
            
            // Add some variation with multiple octaves
            pixelNoise += 0.5  * hash(floor(snowUV * 2.0));
            pixelNoise += 0.25 * hash(floor(snowUV * 4.0));
            pixelNoise /= 1.75; // Normalize
            
            // Threshold based on snow amount - pixels gradually turn white
            float snowThreshold = pixelNoise * 0.95; // Reduced range to cover more area
            float pixelSnow     = step(snowThreshold, snowVisibility); // Fully white
            
            vec3 snowColor = vec3(1.2, 1.2, 1.2); // The light source has blut tint!

            // Apply snow color but preserve lighting/shadows from baseColor
            vec3 litSnowColor = snowColor * (baseColor.rgb / max(terrainBaseColor, vec3(0.01)));

            fragmentColor.rgb = mix(baseColor.rgb, litSnowColor, pixelSnow);
            fragmentColor.a   = baseColor.a;
        }
        else fragmentColor = baseColor;
    }
    else fragmentColor = baseColor;
}



float ShadowCalculation(vec4 vertex_position_lightspace, sampler2D shadowMapSampler, float bias)
{
    // Given the position of a fragment in lightspace coordinates
    // We sample the depth buffer to see whether or not the fragment is shadowed

    // Task 4.3
    // Perspective devide to bring coordinates in range[-1, 1]
    vec3 projCoords = vertex_position_lightspace.xyz / vertex_position_lightspace.w;

    // Since the depth map values are in range[0, 1]
    projCoords = 0.5f * projCoords + 0.5f;

    // Then we get the depth of the current fragment
    float currentDepth = projCoords.z;

    // Task 4.6 Make the shadow edges more realistic
    float shadow = 0.0;
    vec2 depthMap_dimensions = textureSize(shadowMapSampler, 0);
    vec2 texelSize = 1.0 / depthMap_dimensions;
    for(int x = -1; x <= 1; x++ )
        for(int y = -1; y <= 1; y++ )
        {
            float pcfDepth = texture(shadowMapSampler, projCoords.xy + vec2(x, y) * texelSize).r;
            shadow += currentDepth - bias > pcfDepth ? 1.0 : 0.0;
        }
    shadow /= 9.0;

    // Task 4.5
    if(projCoords.z > 1) shadow = 0.0;

    return shadow;
}



vec4 phong(Light light, float visibility, vec4 light_direction_cameraspace)
{
    vec4 _Ks = mtl.Ks;
    vec4 _Kd = mtl.Kd;
    vec4 _Ka = mtl.Ka;
    float _Ns = mtl.Ns;

    if (isTerrain == 1)
    {
        _Ks = 0.3 * vec4(texture(textureSamplerLake, vertex_UV).r);
        _Kd = vec4(terrainBaseColor, 1.0);
        _Ka = vec4(0.2 * _Kd.rgb, _Kd.a);
        _Ns = 200; // Sharp highlights
    }
    else if (useTexture == 1) // use texture for materials
    {
        _Ks = vec4(texture(specularColorSampler, vertex_UV).rgb, 1.0);
        _Kd = vec4(texture(diffuseColorSampler,  vertex_UV).rgb, 1.0);
        _Ka = vec4(0.2 * _Kd.rgb, _Kd.a);
        _Ns = 10;
    }
    
    if (useTransparentTex == 1)
    {   
        // === REMOVE WHITE BACKGROUND === //
        vec4 texColor = texture(diffuseColorSampler, vertex_UV);
        if (texColor.r > 0.35 && texColor.g > 0.6 && texColor.b > 0.35) { discard; }

        _Ks = vec4(0); // No specular for transparent textures...
        _Kd = vec4(texture(diffuseColorSampler,  vertex_UV).rgb, 1.0);
        _Ka = vec4(0.2 * _Kd.rgb, _Kd.a);
        _Ns = 10;
    }
    
    // model ambient intensity (Ia)
    vec4 Ia = light.La * _Ka;

    if (ChampionOfLight == 1) return vec4(Ia * 8); // Helper objects

    // model diffuse intensity (Id)
    vec4 N = normalize(vertex_normal_cameraspace);
    vec4 L = normalize(light_direction_cameraspace);
    float cosTheta = clamp(dot(N, L), 0, 1);
    vec4 Id = light.Ld * _Kd * cosTheta;

    // model specular intensity (Is)
    vec4 R = reflect(-L, N);
    vec4 E = normalize(vec4(0, 0, 0, 1) - vertex_position_cameraspace);
    float cosAlpha        = clamp(dot(E, R), 0, 1);
    float specular_factor = pow(cosAlpha, _Ns);
    vec4 Is = light.Ls * _Ks * specular_factor;

    // here we would normally model the light attenuation effect
    // but since this is a directional light source that is infinitely far away
    // attenuating the light intensity does not make sense

    // final fragment color
    return vec4(
        Ia + 
        Id * visibility + // Task 4.3 Use visibility
        Is * visibility
    );
}



// ============< TERRAIN TEXTURE CREATOR >============ //

float hash(vec2 p) // Cheap ALU-only hash functions for GLSL
{
    p = fract(p * 0.3183099 + vec2(0.71, 0.113));
    return fract(37.0 * p.x * p.y);
}

vec2 rotate(vec2 uv, float r)
{
    int k = int(floor(r * 4.0));

    if (k == 0)      return uv;
    else if (k == 1) return vec2(-uv.y,  uv.x);
    else if (k == 2) return vec2(-uv.x, -uv.y);
    else             return vec2( uv.y, -uv.x);
}

vec3 computeTerrainTexture(vec2 UV)
{

    // Gaea terrain masks
    float slope = texture(textureSamplerSlope, UV).r;
    float soil  = texture(textureSamplerSoil,  UV).r;

    float lake = texture(textureSamplerLake, UV).r;
    lake       = smoothstep(0.2, 0.8, lake);



    vec3 worldColor = texture(textureSamplerWorld, UV).rgb;
    vec3 finalColor; // Final output color
    vec3 rock;

    // Tile scale
    float tileScale = 200.0f;
    vec2  tileLocal = fract(UV * tileScale); // 0..1 inside tile

    { // ROCK, GRASS, DIRT... (Land)

        vec2  tile       = floor(UV * tileScale);
        float tileRandom = hash(tile);

        tileLocal = tileLocal - 0.5; // Center Pivot
        tileLocal = rotate(tileLocal, tileRandom);
        tileLocal = tileLocal + 0.5;

        // Sample materials using tile-local UVs!
        rock       = texture(textureSamplerRock,  tileLocal).rgb;
        vec3 grass = texture(textureSamplerGrass, tileLocal).rgb;
        vec3 dirt  = texture(textureSamplerDirt,  tileLocal).rgb;

        // Blending logic
        vec3 base1 = mix(dirt, grass, soil);
        vec3 base2 = mix(rock, base1, slope * 1.2);

        // Blend with Gaea terrain texture
        finalColor = mix(base2, worldColor, 0.5);

    }

    { // WATERRR... (Lakes)

        float waterTiling = 120.0; // How many times the water texture repeats across the terrain
        vec2 baseUV       = UV * waterTiling;

        // Scroll speed for the water
        vec2 waterScroll = vec2(time * 0.075, -time * 0.15);
        vec2 waterUV     = baseUV + waterScroll;

        // Wave pattern depending on position + time
        float waveSpeed     = 1.5;
        float waveFrequency = 20.0;
        float waveStrength  = 0.02;

        float wave = sin(baseUV.x * waveFrequency + time * waveSpeed) *
                     cos(baseUV.y * waveFrequency + time * waveSpeed);

        // Distort UV slightly by the wave
        waterUV += vec2(wave, wave) * waveStrength;

        vec3 movingWater = texture(textureSamplerWater, waterUV).rgb;

        // Displacement texture for more detail (WATER)
        vec3 displacementTexture = texture(displacementTextureSampler, UV + 0.9*sin(time)).rgb;
        vec3 surfaceTexture      = mix(movingWater, displacementTexture, 0.2);
        vec3 displacedWater      = texture(textureSamplerWater, waterUV + length(surfaceTexture)*0.05).rgb;

        // ... AND SAND!
        vec3 sand      = texture(textureSamplerSand, tileLocal).rgb;
        vec3 sandWater = mix(sand, displacedWater, 0.6).rgb;

        // Blend only where lake mask is > 0
        finalColor = mix(finalColor, sandWater, lake);

    }

    { // RIVERS...

        float riverMask = texture(textureSamplerRivers, UV).r;
        riverMask       = smoothstep(0.05, 0.40, riverMask);

        vec3 dirSample = texture(textureSamplerRiversDirection, UV).rgb;

        // Μετατροπή στο διάστημα [-1,1]
        vec2 flowDir = normalize(dirSample.rg * 2.0 - 1.0);

        float riverTiling = 12.0;
        float riverSpeed  = 0.8;

        vec2 riverUV = UV * riverTiling + flowDir * time * riverSpeed;

        // Displacement & Wobble μέσα στη ροή
        vec2 disp = texture(displacementTextureSampler, UV * 4.0 + flowDir * time * 0.2).rg - vec2(0.5);
        riverUV  += disp * 0.05;

        float wobble = sin(time * 0.5 + dot(UV, vec2(20.0))) * 0.003;
        riverUV     += flowDir * wobble;

        vec3 riverWater = texture(textureSamplerWater, riverUV).rgb;
        vec3 rockyRiver = mix(rock, riverWater, 0.6);

        // Όχι ποτάμια εκεί που υπάρχει λίμνη!
        float riverBlend = riverMask * (1.0 - lake);

        finalColor = mix(finalColor, rockyRiver, riverBlend);

    }

    // Output
    return finalColor;
}

// ============< END TERRAIN TEXTURE CREATOR >============ //
