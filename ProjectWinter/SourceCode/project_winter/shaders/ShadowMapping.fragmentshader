flat in vec3 cameraPos_world;

// Constants
const float THRESHOLD          = 0.001;
const float EPSILON            = 5e-3;
const float HEIGHT_POWER       = 5.0;
const float CRACKS_SCALE       = 0.6;
const float CRACKS_THICKNESS   = 0.9;
const float CRACKS_ALPHA       = 0.8;
const float REFRACTION         = 0.8;
const float BUBBLES_BRIGHTNESS = 0.4;

const vec3  SNOW_COLOR_ICE   = vec3(0.85, 0.98, 1.0);
const vec3  DEEP_COLOR       = vec3(0.0, 0.12, 0.2);
const vec3  CRACKS_COLOR     = vec3(0.3, 0.95, 1.0) * 1.2;
const vec3  CRACKS_COLOR_TOP = vec3(1.6);
#define HASHSCALE3 vec3(.1031, .1030, .0973)



// Helper functions
float triangle(float x) { return abs(1.0 - mod(abs(x), 2.0)) * 2.0 - 1.0; }

vec2 hash22(vec2 p)
{
    vec3 p3 = fract(vec3(p.xyx) * HASHSCALE3);
    p3     += dot(p3, p3.yzx + 19.19);

    return fract((p3.xx + p3.yz) * p3.zy);
}

float hash13(in vec3 p)
{
    p  = fract(p * 0.3183099 + 0.1);
    p *= 17.0;

    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float noise13(in vec3 p)
{
    vec3 i = floor(p);
    vec3 f = fract(p);
    vec3 u = f * f * (3.0 - 2.0 * f);

    float a  = hash13(i + vec3(0.0, 0.0, 0.0));
    float b  = hash13(i + vec3(1.0, 0.0, 0.0));
    float c  = hash13(i + vec3(0.0, 1.0, 0.0));
    float d  = hash13(i + vec3(1.0, 1.0, 0.0));
    float v1 = mix(mix(a, b, u.x), mix(c, d, u.x), u.y);

    a = hash13(i + vec3(0.0, 0.0, 1.0));
    b = hash13(i + vec3(1.0, 0.0, 1.0));
    c = hash13(i + vec3(0.0, 1.0, 1.0));
    d = hash13(i + vec3(1.0, 1.0, 1.0));

    float v2 = mix(mix(a, b, u.x), mix(c, d, u.x), u.y);

    return abs(mix(v1, v2, u.z));
}

vec2 noise2(in vec2 p)
{
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);

    return -1.0 + 2.0 * mix(
        mix(hash22(i + vec2(0.0, 0.0)), hash22(i + vec2(1.0, 0.0)), u.x),
        mix(hash22(i + vec2(0.0, 1.0)), hash22(i + vec2(1.0, 1.0)), u.x),
        u.y
    );
}

float noise12_from2(vec2 p) { return noise2(p).x; } // Scalar noise

float getSnowMaskIce(in vec2 p)
{
    mat2 m = mat2( 1.6,  1.2,
                  -1.2,  1.6 );

    float a = 1.0;
    float w = 1.0;

    float f = abs(noise12_from2(p));
    for (int i = 0; i < 6; i++)
    {
        p  = m * p;
        a /= 1.5;

        f += a * abs(noise12_from2(p));
        w += a;
    }

    f /= w;

    // Patchy threshold -> soft blobs
    f  = smoothstep(0.55, 0.65, f);
    f  = pow(f, 0.25);
    f *= 0.9;

    return f; // 0..1
}

vec3 voronoi(in vec2 x)
{
    vec2 n = floor(x);
    vec2 f = fract(x);

    vec2 mg, mr;
    float md = 8.0;
    for (int j = -1; j <= 1; j++)
        for (int i = -1; i <= 1; i++)
        {
            vec2 g = vec2(float(i), float(j));
            vec2 o = hash22(n + g);
            vec2 r = g + o - f;
            float d = dot(r, r);
            if (d < md) { md = d; mr = r; mg = g; }
        }

    md = 8.0;
    for (int j = -1; j <= 1; j++)
        for (int i = -1; i <= 1; i++)
        {
            vec2 g = mg + vec2(float(i), float(j));
            vec2 o = hash22(n + g);
            vec2 r = g + o - f;
            if (dot(mr - r, mr - r) > 0.00001)
                md = min(md, dot(0.5 * (mr + r), normalize(r - mr)));
        }

    return vec3(md, mr);
}

void intersectionPlaneY(in vec3 o, in vec3 d, in float yPlane, out vec3 p)
{
    float denom = (abs(d.y) < 1e-5) ? (d.y < 0.0 ? -1e-5 : 1e-5) : d.y;
    float t     = (o.y - yPlane) / denom;

    p = o - d * t;
}

float mapCracks1(vec3 p)
{
    const float SCALE = 0.1;
    p.x += sin(p.z * 0.2) * 2.0;
    p.x += triangle(p.z * 0.053) * 2.0;
    p.z += triangle(p.x * 0.103) * 2.0;

    return voronoi(p.xz * SCALE).x / SCALE * 0.9;
}

float mapCracks2(vec3 p)
{
    const float SCALE = 0.25;
    p.x += triangle(p.z * 0.153) * 1.5;
    p.z += triangle(p.x * 0.203) * 1.5;

    return voronoi(p.xz * SCALE).x / SCALE * 0.9;
}

vec2 traceCracks1(vec3 ori, vec3 dir, out vec3 p)
{
    float t = 0.0; float d = 0.0;
    for (int i = 0; i < 10; i++)
    {
        p = ori + dir * t; d = mapCracks1(p);
        if (d < THRESHOLD) break;
        t += d * 0.9;
    }

    return vec2(d, t);
}

vec2 traceCracks2(vec3 ori, vec3 dir, float s, out vec3 p)
{
    float t = 0.0; float d = 0.0;
    for (int i = 0; i < 8; i++)
    {
        p = ori + dir * t; d = mapCracks2(p * s);
        if (d < THRESHOLD) break;
        t += d * 0.9;
    }

    return vec2(d, t);
}

vec2 getNormalCracks1(vec3 p)
{
    float t = mapCracks1(p);
    vec2 n;
    n.x = mapCracks1(vec3(p.x + EPSILON, p.y, p.z)) - t;
    n.y = mapCracks1(vec3(p.x, p.y, p.z + EPSILON)) - t;

    return normalize(n);
}

vec2 getNormalCracks2(vec3 p)
{
    float t = mapCracks2(p);
    vec2 n;
    n.x = mapCracks2(vec3(p.x + EPSILON, p.y, p.z)) - t;
    n.y = mapCracks2(vec3(p.x, p.y, p.z + EPSILON)) - t;

    return normalize(n);
}



// Frozen Lake - Main function
vec3 frozenLakeColor_Alekseev(vec3 baseUnderIce)
{
    vec3 p = vertex_position_worldspace * CRACKS_SCALE;
    vec3 e = normalize(vertex_position_worldspace - cameraPos_world);

    float depth   = length(vertex_position_worldspace - cameraPos_world);
    float depth_f = max(depth * 0.8, 1.0);

    // global thickness modulation
    float gth = (0.6 + 0.8 * smoothstep(0.2, 0.8, noise13(p * 0.05))) * CRACKS_THICKNESS;

    // crack depth - fake surface normal
    vec3 norm = vec3(1.0, noise2(p.xz * 3.0) * 0.2);
    norm.yz  += noise2(p.xz * 10.0) * 0.2;
    norm.x   *= depth_f;
    norm      = normalize(norm.yxz);

    vec3 et = e;
    et.xz  += norm.xz * REFRACTION;

    vec3 cp;
    traceCracks1(p, et, cp);
    float crack1 = pow(max(1.0 - abs(cp.y - p.y) * 0.2 / gth, 0.0), HEIGHT_POWER) * 0.6;
    crack1      *= (0.5 + 0.5 * noise13(cp * vec3(0.7, 10.0, 0.7))) * (abs(getNormalCracks1(cp).x) * 0.6 + 0.4);

    traceCracks2(p, et, 1.0, cp);
    float crack2 = pow(max(1.0 - abs(cp.y - p.y) * 0.4 / gth, 0.0), HEIGHT_POWER) * 0.6;
    crack2      *= (0.5 + 0.5 * smoothstep(0.2, 0.9, noise13(cp * vec3(12.0, 1.0, 12.0)))) * (abs(getNormalCracks2(cp).x) * 0.6 + 0.4);

    // base color
    vec3 col = DEEP_COLOR;

    // bubbles
    vec3 dirBub = e; dirBub.xz += norm.xz * REFRACTION * 0.3;
    vec3 bp;
    intersectionPlaneY(cameraPos_world + vec3(0.0, 0.5, 0.0), dirBub, (vertex_position_worldspace.y - 0.5), bp);
    col += pow(noise13(bp * 14.0), 20.0) * BUBBLES_BRIGHTNESS * gth;
    intersectionPlaneY(cameraPos_world + vec3(0.0, 1.0, 0.0), dirBub, (vertex_position_worldspace.y - 1.0), bp);
    col += pow(noise13(bp * 15.0), 20.0) * BUBBLES_BRIGHTNESS * gth;

    float a = (0.4 + 0.6 * smoothstep(0.2, 0.8, noise13(p * 0.07))) * CRACKS_ALPHA;
    col     = mix(col, mix(CRACKS_COLOR, CRACKS_COLOR_TOP, crack2), crack2 * a);
    col     = mix(col, mix(CRACKS_COLOR, CRACKS_COLOR_TOP, crack1), crack1 * a);

    // reflection - NO FRESNEL!
    vec3 reflection = vec3(0.0);
    if (useReflection == 1)
    {
        float w    = max(vertex_position_clipspace.w, 1e-5);
        vec2 ndc   = (vertex_position_clipspace.xy / w) * 0.5 + 0.5;
        reflection = texture(reflectionTextureSampler, ndc).rgb;
    }
    else
        reflection = mix(vec3(0.02, 0.03, 0.05), vec3(0.35, 0.45, 0.6), clamp(reflect(e, norm).y * 0.5 + 0.5, 0.0, 1.0));
    col = mix(col, reflection, 0.22);



    // ===< Water starts INSIDE crack lines, then expands outward! >=== //

    // The lake can only be frozen if 0.75 < snowAmount < 1.0
    float freezeAmt  = smoothstep(0.75, 1.0, snowAmount);
    // Melt starts from cracks first (meltCracks), then the whole surface (meltGlobal)
    float meltCracks = freezeAmt * smoothstep(0.12, 0.04, fogDensity);
    float meltGlobal = freezeAmt * smoothstep(0.04, 0.00, fogDensity);

    float meltCoverage = 0.0; // Where the ice has turned back into liquid water!
    if (meltCracks > 0.0001)
    {
        // Distance from the current fragment to the nearest crack...
        float dLine = min(mapCracks1(p), mapCracks2(p));

        // Identify deeper/heavier cracks
        float deep = clamp(crack1 + crack2, 0.0, 1.0);

        // Expansion width grows as thaw progresses...
        float width = mix(0.02, 8.0, meltCracks * meltCracks);

        // Normalize distance so deep cracks expand faster!
        float dn = dLine / (0.20 + 0.80 * deep);

        // 1 near crack center -> expands outward
        meltCoverage = 1.0 - smoothstep(0.0, width, dn);

        // Final stage - Fully return to water!
        meltCoverage = clamp(max(meltCoverage, meltGlobal), 0.0, 1.0);
    }

    {   // Snow patches on top of the ice
        float depth_f = max(depth * 0.01, 1.0);

        float snowPatch = getSnowMaskIce(p.xz * 0.1) / depth_f;
        snowPatch      *= freezeAmt;
        snowPatch      *= (1.0 - meltCoverage); // Disappear as water returns...
        snowPatch       = clamp(snowPatch, 0.0, 1.0);

        col = mix(col, SNOW_COLOR_ICE, snowPatch);
    }

    // Return the surface...
    float iceWeight = 0.85 * (1.0 - meltCoverage);
    return mix(baseUnderIce, col, iceWeight);
}

// ==================== END "Frozen Lake" ==================== //



// Helpers
vec4 phong(Light light, float visibility, vec4 light_direction_cameraspace);
float ShadowCalculation(vec4 vertex_position_lightspace, sampler2D shadowMapSampler, float bias);

vec3 computeLandTexture();
vec3 computeLakeTexture();
vec3 computeRiverTexture();
float hash(vec2 p);

void main()
{
    // ALWAYS initialize - Windows 11 is a thing, unfortunately...
    fragmentColor = vec4(0.0);

    // Compute terrain texture ONCE per fragment!!!
    if      (terrainType == 1) terrainBaseColor = computeLandTexture();
    else if (terrainType == 2) terrainBaseColor = computeLakeTexture();
    else if (terrainType == 3) terrainBaseColor = computeRiverTexture();

    // ===< light 1 >=== //
    float visibility = 1.0 - ShadowCalculation(vertex_position_lightspace1, shadowMapSampler1, 0.0004);
    vec4 baseColor   = phong(light1, visibility, light_direction_cameraspace1);

    fragmentColor = baseColor; // NO SNOW!!!



    // ===< SNOW ACCUMULATION >=== //
    if (snowAmount > 0.0 && terrainType != 2 && terrainType != 3)
    {
        // Vegetation bends in wind: sample snow using the NO-WIND anchor so it doesn't slide in world space...
        vec4 snowPosition  = (terrainType == 1) ? vertex_position_snowspace : vertex_position_snowspace_s;
        float snowBlocked  = ShadowCalculation(snowPosition, snowDepthMapSampler, 0.001);
        float snowExposure = 1.0 - snowBlocked;

        if (snowInflate > 0.0f && terrainType == 1) // Now snow starts covering the whole land terrain!
        {
            snowBlocked -= snowInflate * 2.0;
            snowExposure = 1.0 - snowBlocked;
        }

        // Prevent snow from accumulating on very steep slopes!
        {
            vec3 worldUp = vec3(0.0, 1.0, 0.0);
            vec3 nWorld  = normalize(vertex_normal_worldspace);

            float cosTheta = clamp(dot(nWorld, worldUp), 0.0, 1.0);
            float theta    = acos(cosTheta); // radians

            float minSlopeRad = radians(70.0);
            float maxSlopeRad = radians(90.0);

            float t = smoothstep(minSlopeRad, maxSlopeRad, theta);

            float slopeSnowMask = 1.0 - t;
            snowExposure       *= slopeSnowMask;
        }

        // If this is land terrain, use the mask to prevent snow...
        if (terrainType == 1)
        {
            float gaeaSnowMask = texture(textureSamplerSnowMask, vertex_UV).r;
            snowExposure      *= gaeaSnowMask;
        }

        float snowVisibility = snowExposure * snowAmount; // FINAL SNOW MASK
        snowVisibility       = clamp(snowVisibility, 0.0, 1.0);

        if (snowVisibility > 0.001)
        {
            // Pixel-by-pixel snow accumulation using noise
            vec2 snowUV      = (terrainType == 1) ? vertex_position_worldspace.xz : vertex_position_worldspace_s.xz;
            snowUV          *= 4.0; // Small snow pixels!
            float pixelNoise = hash(floor(snowUV));

            // Add some variation with multiple octaves
            pixelNoise += 0.5  * hash(floor(snowUV * 2.0));
            pixelNoise += 0.25 * hash(floor(snowUV * 4.0));
            pixelNoise /= 1.75; // Normalize

            // Threshold based on snow amount - pixels gradually turn white
            float snowThreshold = pixelNoise * 0.95; // Reduced range to cover more area
            float pixelSnow     = step(snowThreshold, snowVisibility); // Fully white

            vec3 snowColor = vec3(1.0, 1.0, 0.9); // The light source has blut tint!

            vec3 albedo = terrainBaseColor; // Base color before lighting...
            if (terrainType == 0)
            {
                if (useTexture == 1 || useTransparentTex == 1)
                    albedo = texture(diffuseColorSampler, vertex_UV).rgb;
                else
                    albedo = mtl.Kd.rgb;
            }

            // Apply snow color but preserve lighting/shadows from baseColor
            vec3 litSnowColor = snowColor * (baseColor.rgb / max(albedo, vec3(0.01)));

            fragmentColor.rgb = mix(baseColor.rgb, litSnowColor, pixelSnow);
            fragmentColor.a   = baseColor.a;
        }
    }

    { // ===< FOG LOGIC >=== // ===< Better Snow effect >=== //

        // Calculate distance from camera
        float dist = length(vertex_position_cameraspace.xyz);

        float fogDensityScaled = fogDensity * 0.03;

        // Calculate exponential fog factor
        float fogFactor = 1.0 / exp( (dist * fogDensityScaled) * (dist * fogDensityScaled) );
        fogFactor       = clamp(fogFactor, 0.0, 1.0);

        fragmentColor.rgb = mix(fogColor, fragmentColor.rgb, fogFactor);

    }
}

float ShadowCalculation(vec4 vertex_position_lightspace, sampler2D shadowMapSampler, float bias)
{
    // Given the position of a fragment in lightspace coordinates
    // We sample the depth buffer to see whether or not the fragment is shadowed

    // Task 4.3
    // Perspective devide to bring coordinates in range[-1, 1]
    vec3 projCoords = vertex_position_lightspace.xyz / vertex_position_lightspace.w;

    // Since the depth map values are in range[0, 1]
    projCoords = 0.5f * projCoords + 0.5f;

    // Then we get the depth of the current fragment
    float currentDepth = projCoords.z;

    // Task 4.6 Make the shadow edges more realistic
    float shadow             = 0.0;
    vec2 depthMap_dimensions = textureSize(shadowMapSampler, 0);
    vec2 texelSize           = 1.0 / depthMap_dimensions;

    for (int x = -1; x <= 1; x++)
        for (int y = -1; y <= 1; y++)
        {
            float pcfDepth = texture(shadowMapSampler, projCoords.xy + vec2(x, y) * texelSize).r;
            shadow        += (currentDepth - bias > pcfDepth) ? 1.0 : 0.0;
        }
    shadow /= 9.0;

    // Task 4.5
    if (projCoords.z > 1.0) shadow = 0.0;

    return shadow;
}

vec4 phong(Light light, float visibility, vec4 light_direction_cameraspace)
{
    vec4 _Ks = mtl.Ks;
    vec4 _Kd = mtl.Kd;
    vec4 _Ka = mtl.Ka;
    float _Ns = mtl.Ns;

    if (terrainType == 0) // Just to be sure...
    {
        if (useTexture == 1) // use texture for materials
        {
            _Ks = vec4(texture(specularColorSampler, vertex_UV).rgb, 1.0);
            _Kd = vec4(texture(diffuseColorSampler,  vertex_UV).rgb, 1.0);
            _Ka = vec4(0.2 * _Kd.rgb, _Kd.a);
            _Ns = 10.0;
        }
        
        if (useTransparentTex == 1)
        {
            // === REMOVE WHITE BACKGROUND === //
            vec4 texColor = texture(diffuseColorSampler, vertex_UV);
            if (texColor.r > 0.35 && texColor.g > 0.6 && texColor.b > 0.35) { discard; }

            _Ks = vec4(0.0); // No specular for transparent textures...
            _Kd = vec4(texture(diffuseColorSampler, vertex_UV).rgb, 1.0);
            _Ka = vec4(0.2 * _Kd.rgb, _Kd.a);
            _Ns = 10.0;
        }
    }
    else
    {
        if (terrainType == 2)
        {
            // ===< FREEZING GLARE >=== //
            float iceSpecular = mix(0.3, 1.0, snowAmount);

            _Ks = iceSpecular * vec4(1.0, 1.0, 1.0, 1.0);
            _Kd = vec4(terrainBaseColor, 1.0);
            _Ka = vec4(0.2 * _Kd.rgb, _Kd.a);
            _Ns = mix(200.0, 600.0, snowAmount); // Smoother ice...
        }
        else
        {
            _Ks = vec4(0);
            _Kd = vec4(terrainBaseColor, 1.0);
            _Ka = vec4(0.2 * _Kd.rgb, _Kd.a);
            _Ns = 10.0;
        }
    }

    // model ambient intensity (Ia)
    vec4 Ia = light.La * _Ka;
    if (ChampionOfLight == 1) return vec4(Ia * 8.0); // Helper objects

    // model diffuse intensity (Id)
    vec4 N = normalize(vertex_normal_cameraspace);
    vec4 L = normalize(light_direction_cameraspace);
    float cosTheta = clamp(dot(N, L), 0.0, 1.0);

    vec4 Id = light.Ld * _Kd * cosTheta;

    // model specular intensity (Is)
    vec4 R = reflect(-L, N);
    vec4 E = normalize(vec4(0.0, 0.0, 0.0, 1.0) - vertex_position_cameraspace);
    float cosAlpha        = clamp(dot(E, R), 0.0, 1.0);
    float specular_factor = pow(cosAlpha, _Ns);

    vec4 Is = light.Ls * _Ks * specular_factor;

    // here we would normally model the light attenuation effect
    // but since this is a directional light source that is infinitely far away
    // attenuating the light intensity does not make sense

    // final fragment color
    return vec4(
        Ia +
        Id * visibility + // Task 4.3 Use visibility
        Is * visibility
    );
}



// ============< TERRAIN TEXTURE CREATOR >============ //

float hash(vec2 p) // Cheap ALU-only hash functions for GLSL
{
    p = fract(p * 0.3183099 + vec2(0.71, 0.113));
    return fract(37.0 * p.x * p.y);
}

vec2 getTileUV() // Get randomized UVs...
{
    vec2 tiled = vertex_UV * tileScale;
    vec2 local = fract(tiled); // 0..1 inside tile
    vec2 grid  = floor(tiled);
    
    float r = hash(grid);
    int k   = int(floor(r * 4.0));

    local = local - 0.5; // Center Pivot
    
    // Apply rotation to break tiling
    if      (k == 1) local = vec2(-local.y,  local.x);
    else if (k == 2) local = vec2(-local.x, -local.y);
    else if (k == 3) local = vec2( local.y, -local.x);

    return local + 0.5;
}

// ROCK, GRASS... (Land)
vec3 computeLandTexture()
{
    // ---< Cache Gaea terrain masks ONCE >--- //
    gaeaSlopeMask   = texture(textureSamplerSlope, vertex_UV).r;
    vec3 worldColor = texture(textureSamplerWorld, vertex_UV).rgb;
    
    vec2 randomizedUV = getTileUV();
    
    // Sample materials using tile-local UVs!
    vec3 rock  = texture(textureSamplerRock,  randomizedUV).rgb;
    vec3 grass = texture(textureSamplerGrass, randomizedUV).rgb;
    
    // Blending logic
    float slopeBlend = clamp(gaeaSlopeMask * 1.2, 0.0, 1.0);
    vec3 details     = mix(rock, grass, slopeBlend); 

    // Output
    return mix(details, worldColor, 0.5); // Blend with Gaea terrain texture
}

// WATERRR... (Lake)
vec3 computeLakeTexture()
{
    float effectiveTime = (snowAmount > 0.0 && fogDensity > 0.4) ? 0.0 : time; // ===< STILLNESS LOGIC >=== //

    float freezeAmt  = smoothstep(0.75, 1.0, snowAmount);
    float meltGlobal = freezeAmt * smoothstep(0.04, 0.00, fogDensity);

    float waterTiling = 120.0; // How many times the water texture repeats across the terrain
    vec2 baseUV       = vertex_UV * waterTiling;

    // Scroll speed for the water
    vec2 waterScroll = vec2(effectiveTime * 0.5, -effectiveTime * 0.8);
    vec2 waterUV     = baseUV + waterScroll;

    // Wave pattern depending on position + time
    float waveSpeed     = 1.5;
    float waveFrequency = 20.0;
    float waveStrength  = 0.02;

    float wave = sin(baseUV.x * waveFrequency + effectiveTime * waveSpeed) *
                 cos(baseUV.y * waveFrequency + effectiveTime * waveSpeed);

    // Distort UV slightly by the wave
    waterUV += vec2(wave, wave) * waveStrength;

    vec3 movingWater = texture(textureSamplerWater, waterUV).rgb;

    // ===< FREEZING LAKE EFFECT >=== //
    vec3 iceColor      = vec3(0.95, 0.98, 1.0);
    float freezeFactor = smoothstep(0.1, 0.9, snowAmount) * 0.95; // Non-linear freeze!
    freezeFactor      *= (1.0 - meltGlobal); // Even if it is snowy -> fogDensity can melt the ice...
    movingWater        = mix(movingWater, iceColor, freezeFactor);

    // Displacement texture for more detail (WATER)
    vec3 displacementTexture = texture(displacementTextureSampler, vertex_UV + 0.9*sin(effectiveTime)).rgb;
    vec3 surfaceTexture      = mix(movingWater, displacementTexture, 0.2);
    vec3 displacedWater      = texture(textureSamplerWater, waterUV + length(surfaceTexture)*0.05).rgb;

    // ===< LAKE REFLECTION >=== //
    if (useReflection == 1)
    {
        // Calculate reflection texture coordinates from clip space
        float w           = max(vertex_position_clipspace.w, 1e-5);
        vec2 ndc          = (vertex_position_clipspace.xy / w) * 0.5 + 0.5;
        vec2 reflectionUV = ndc;

        // DISTORTION: Apply the SAME wave distortion to the reflection!
        float freezeDampen = mix(1.0 - snowAmount, 1.0, meltGlobal); // Reduce distortion

        vec2 reflectionDistortion = vec2(wave, wave) * waveStrength * 0.5; // Less distortion...
        reflectionDistortion     += (displacementTexture.xy - 0.5) * 0.01; // Add high-frequency noise

        reflectionDistortion *= freezeDampen; // Apply dampening

        // Sample reflection texture with distortion!
        vec3 reflectionColor = texture(reflectionTextureSampler, reflectionUV + reflectionDistortion).rgb;

        // Mix the water texture with the reflection...
        float reflectionStrength = mix(0.2, 0.8, snowAmount * (1.0 - meltGlobal)); // Stronger Reflection
        
        displacedWater = mix(displacedWater, reflectionColor, reflectionStrength);
    }

    {   // Snow patches on top of the ice
        float depth   = length(vertex_position_worldspace - cameraPos_world);
        float depth_f = max(depth * 0.01, 1.0);

        float snowPatch = getSnowMaskIce((vertex_position_worldspace.xz * CRACKS_SCALE) * 0.1) / depth_f;
        snowPatch      *= freezeFactor;
        snowPatch      *= smoothstep(0.75, 1.0, snowAmount);
        snowPatch      *= (1.0 - meltGlobal);
        snowPatch       = clamp(snowPatch, 0.0, 1.0);

        displacedWater = mix(displacedWater, SNOW_COLOR_ICE, snowPatch);
    }

    // ... AND SAND!
    vec3 sand      = texture(textureSamplerSand, getTileUV()).rgb;
    vec3 sandWater = mix(sand, displacedWater, 0.6); // Final color fragment for lake!

    // ===< ALEKSEEV "Frozen Lake" >=== //
    if (fogDensity < 0.6 && snowAmount > 0.6 && meltGlobal < 0.999)
    {
        // Define the point where the freeze begins
        vec3 freezeOrigin = vec3(0.0, 58.1, 0.0); // Using WATER_HEIGHT from main.cpp
        
        // Add jitter to the distance so the ice growth looks "jagged" and organic
        float organicNoise = hash(vertex_position_worldspace.xz * 0.1) * 20.0;
        float distToOrigin = distance(vertex_position_worldspace.xz, freezeOrigin.xz) + organicNoise;
        
        // Expansion radius: spreads as fogDensity decreases...
        float expansionFactor = clamp(((1.0 - fogDensity) - 0.5) * 2.0, 0.0, 1.0);
        float maxRadius       = 400.0; // Increased radius to cover the map extent
        float currentRadius   = expansionFactor * maxRadius;
        
        // Blend factor: 1.0 = Cracked Ice, 0.0 = Moving Water
        float crackBlend = 1.0 - smoothstep(currentRadius - 80.0, currentRadius, distToOrigin);
        
        if (crackBlend > 0.001)
        {
            // Calculate the high-fidelity Alekseev cracked ice
            vec3 alekseevIce = frozenLakeColor_Alekseev(sandWater);
            
            // Final spatial blend
            sandWater = mix(sandWater, alekseevIce, crackBlend);
        }
    }

    // Blend only where lake mask is > 0
    return sandWater;
}

// RIVERS...
vec3 computeRiverTexture()
{
    vec3 dirSample = texture(textureSamplerRiversDirection, vertex_UV).rgb;
    vec3 rock      = texture(textureSamplerRock, getTileUV()).rgb;

    // Μετατροπή στο διάστημα [-1,1]
    vec2 flowDir = normalize(dirSample.rg * 2.0 - 1.0);

    float riverTiling = 20.0;
    float riverSpeed  =  1.2;

    vec2 riverUV = vertex_UV * riverTiling + flowDir * time * riverSpeed;

    // Displacement & Wobble μέσα στη ροή
    vec2 disp = texture(displacementTextureSampler, vertex_UV * 4.0 + flowDir * time * 0.2).rg - vec2(0.5);
    riverUV  += disp * 0.05;

    float wobble = sin(time * 0.5 + dot(vertex_UV, vec2(20.0))) * 0.003;
    riverUV     += flowDir * wobble;

    vec3 riverWater = texture(textureSamplerWater, riverUV).rgb;
    vec3 rockyRiver = mix(rock, riverWater, 0.6);

    return rockyRiver;
}

