#version 330 core

out vec4 fragmentColor;

void main()
{
    vec2 coord = gl_PointCoord - vec2(0.5);
    float len  = dot(coord, coord); // Faster than length()
    if (len > 0.4) discard;         // Cut into circle
    
    float alpha = 1.0 - smoothstep(0.3, 0.5, len); // Soft edge

    fragmentColor = vec4(1.0, 1.0, 1.0, alpha);
}
